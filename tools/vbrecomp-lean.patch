new file mode 100644
index 0000000..7534851
--- /dev/null
+++ b/recompiler/tests/test_lean.py
@@ -0,0 +1,160 @@
+"""Tests for v810/lean.py, the compact emitter behind `--lean`."""
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+from recompiler.v810.analysis import RomImage
+from recompiler.v810.lean import _idle_spin_address, recompile_rom_lean
+
+from recompiler.tests.test_emitter import (
+    _enc_bcond,
+    _enc_fmt_i,
+    _enc_fmt_ii,
+    _enc_fmt_iv,
+    _enc_fmt_v,
+    _install_trampoline,
+    _make_rom,
+)
+
+ENTRY = 0x07000020
+RUNTIME_INCLUDE = Path(__file__).resolve().parents[2] / "runtime" / "include"
+
+
+def _body(result) -> str:
+    return "\n".join(v for k, v in sorted(result.files.items())
+                     if k.endswith(".c") and "dispatch" not in k)
+
+
+def _recompile(rom):
+    _install_trampoline(rom, ENTRY)
+    return recompile_rom_lean(RomImage.from_bytes(bytes(rom)),
+                              module_name="testcart")
+
+
+def _decode(rom, start, count):
+    img = RomImage.from_bytes(bytes(rom))
+    out, pc = [], start
+    for _ in range(count):
+        ins = img.decode_at_va(pc)
+        out.append(ins)
+        pc += ins.size
+    return out
+
+
+class TestLeanShape(unittest.TestCase):
+    def _call_rom(self):
+        rom = _make_rom()
+        rom[0x20:0x24] = _enc_fmt_iv(0x2B, 0x40)   # JAL +0x40
+        rom[0x24:0x26] = _enc_fmt_ii(0x1A, 0, 0)   # HALT
+        rom[0x60:0x62] = _enc_fmt_i(0x00, 2, 1)    # MOV r1, r2
+        rom[0x62:0x64] = _enc_fmt_i(0x06, 0, 31)   # JMP r31
+        return rom
+
+    def test_call_is_direct_and_bookkeeping_is_gone(self):
+        result = _recompile(self._call_rom())
+        body = _body(result)
+        self.assertIn("vb_fn_07000060(cpu);", body)
+        self.assertIn("vb_dispatch_until(cpu, 0x07000024u)", body)
+        for gone in ("step_budget", "vb_execution_before", "VB_CPUHOOK",
+                     "vb_fntrace_record", "native_instructions"):
+            self.assertNotIn(gone, body)
+        # HALT must leave an absolute resume PC: cpu->pc is not kept
+        # current per instruction in lean code.
+        self.assertIn("cpu->pc = 0x07000026u; cpu->halted = 1; return;", body)
+        self.assertNotIn("cpu->pc += 2", body)
+
+    def test_resume_points_are_block_leaders_only(self):
+        result = _recompile(self._call_rom())
+        dispatch = result.files["generated/testcart_dispatch.c"]
+        self.assertIn("{0x07000024u, ", dispatch)       # return address
+        self.assertNotIn("{0x07000062u, ", dispatch)    # mid-block insn
+
+    def test_output_compiles(self):
+        cc = shutil.which("cc") or shutil.which("gcc") or shutil.which("clang")
+        if cc is None:
+            self.skipTest("no C compiler available")
+        result = _recompile(self._call_rom())
+        with tempfile.TemporaryDirectory() as tmp:
+            for rel, text in result.files.items():
+                Path(tmp, os.path.basename(rel)).write_text(text)
+            for name in os.listdir(tmp):
+                if name.endswith(".c"):
+                    subprocess.run(
+                        [cc, "-std=c11", "-fsyntax-only", "-w",
+                         f"-I{RUNTIME_INCLUDE}", f"-I{tmp}",
+                         str(Path(tmp, name))], check=True)
+
+
+class TestLeanFlags(unittest.TestCase):
+    def test_overwritten_flags_are_not_written(self):
+        rom = _make_rom()
+        rom[0x20:0x22] = _enc_fmt_i(0x01, 2, 1)    # ADD r1, r2  (flags dead)
+        rom[0x22:0x24] = _enc_fmt_i(0x01, 3, 1)    # ADD r1, r3  (flags live)
+        rom[0x24:0x26] = _enc_fmt_i(0x06, 0, 31)   # JMP r31
+        lines = [l for l in _body(_recompile(rom)).splitlines()
+                 if "_r=_a+_b" in l]
+        self.assertEqual(len(lines), 2)
+        self.assertNotIn("psw_", lines[0])
+        for flag in ("psw_z", "psw_s", "psw_cy", "psw_ov"):
+            self.assertIn(f"cpu->{flag}=", lines[1])
+
+    def test_compare_and_branch_becomes_c_comparison(self):
+        rom = _make_rom()
+        rom[0x20:0x22] = _enc_fmt_i(0x03, 2, 1)    # CMP r1, r2
+        rom[0x22:0x24] = _enc_bcond(0x6, 0x8)      # BLT +8 -> 0x2A
+        rom[0x24:0x26] = _enc_fmt_ii(0x10, 5, 1)   # MOV 1, r5
+        rom[0x26:0x28] = _enc_fmt_i(0x01, 5, 5)    # ADD r5, r5 (redefines flags)
+        rom[0x28:0x2A] = _enc_fmt_i(0x06, 0, 31)   # JMP r31
+        rom[0x2A:0x2C] = _enc_fmt_i(0x01, 6, 6)    # ADD r6, r6 (redefines flags)
+        rom[0x2C:0x2E] = _enc_fmt_i(0x06, 0, 31)   # JMP r31
+        body = _body(_recompile(rom))
+        self.assertIn("if (((int32_t)lc_a < (int32_t)lc_b))", body)
+        cmp_line = next(l for l in body.splitlines() if "_r=_a-_b" in l)
+        # Both successors overwrite every flag first, so the compare
+        # itself stores nothing to the CPU struct.
+        self.assertNotIn("cpu->psw_", cmp_line)
+
+
+class TestLeanIdleSpin(unittest.TestCase):
+    def _loop(self, extra=b""):
+        rom = _make_rom()
+        code = (_enc_fmt_v(0x2F, 1, 0, 0x0500)       # MOVHI 0x0500, r0, r1
+                + _enc_fmt_v(0x31, 10, 1, 14)        # LD.H 14[r1], r10
+                + extra
+                + _enc_fmt_ii(0x13, 10, 0))          # CMP 0, r10
+        back = -len(code)
+        code += _enc_bcond(0x2, back)                # BE loop
+        code += _enc_fmt_i(0x06, 0, 31)              # JMP r31
+        rom[0x20:0x20 + len(code)] = code
+        return rom
+
+    def test_wait_loop_gets_skip_hook(self):
+        body = _body(_recompile(self._loop()))
+        self.assertIn(
+            "VB_LEAN_IDLE_SPIN(cpu, 8, (cpu->gpr[1] + (uint32_t)(14)));", body)
+        self.assertIn("VB_LEAN_YIELD_CHECK(cpu, 0x07000020u);", body)
+
+    def test_loop_with_carried_state_is_not_a_wait_loop(self):
+        counter = _enc_fmt_ii(0x11, 11, 1)           # ADD 1, r11
+        self.assertNotIn("VB_LEAN_IDLE_SPIN",
+                         _body(_recompile(self._loop(counter))))
+
+    def test_store_disqualifies(self):
+        rom = _make_rom()
+        rom[0x20:0x24] = _enc_fmt_v(0x31, 10, 1, 14)   # LD.H 14[r1], r10
+        rom[0x24:0x28] = _enc_fmt_v(0x35, 10, 1, 16)   # ST.H r10, 16[r1]
+        self.assertIsNone(_idle_spin_address(_decode(rom, 0x07000020, 2)))
+
+    def test_clobbered_base_disqualifies(self):
+        rom = _make_rom()
+        rom[0x20:0x24] = _enc_fmt_v(0x31, 1, 1, 14)    # LD.H 14[r1], r1
+        self.assertIsNone(_idle_spin_address(_decode(rom, 0x07000020, 1)))
+
+
+if __name__ == "__main__":
+    unittest.main()
